# ── Dify ─────────────────────────────────────────────────────────────
# Required by Dify's own .env (dify/docker/.env). Also used here if you run
# a local SSOT service alongside Dify.
SECRET_KEY=change-me

# ── LLM provider ──────────────────────────────────────────────────────
# OpenAI is the default; configure in Dify → Settings → Model Provider.
OPENAI_API_KEY=

# Azure OpenAI (alternative provider — uncomment and fill)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-01

# ── Optional: external SSOT service ───────────────────────────────────
# Bearer token the workflow's fetch step uses to pull + redact your profile.
# Leave empty if you pass `redacted_ssot` as a workflow input instead.
# SSOT_API_TOKEN=
# SSOT_BASE_URL=

# ── Optional: drive the workflow from the command line ────────────────
# App API key from Dify console → your app → API Access.
# DIFY_BASE_URL=http://localhost/v1
# DIFY_API_KEY=app-...
