# ── Dify ─────────────────────────────────────────────────────────────
# Required by Dify's own .env (dify/docker/.env). Also used here if you run
# a local SSOT service alongside Dify.
SECRET_KEY=change-me

# ── LLM provider ──────────────────────────────────────────────────────
# OpenAI is the default; configure in Dify → Settings → Model Provider.
OPENAI_API_KEY=

# Azure OpenAI (alternative provider — uncomment and fill)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-02-01

# ── App environment variable (set in Dify console, NOT here) ──────────
# PII_JSON — secret env var on the imported app (⋯ → Environment Variables).
# Holds your identity.pii JSON in the shape of examples/pii.example.json;
# merged back into generated docs after the LLM nodes, never seen by a model.

# ── Optional: external SSOT service ───────────────────────────────────
# Bearer token the workflow's fetch step uses to pull + redact your profile.
# Leave empty if you pass `ssot_json` as a workflow input instead.
# SSOT_API_TOKEN=
# SSOT_BASE_URL=

# ── Optional: drive the workflow from the command line / MCP ──────────
# App API key from Dify console → your app → API Access.
# DIFY_BASE_URL=http://localhost/v1
# DIFY_API_KEY=app-...

# ── MCP server (mcp/server.py) ────────────────────────────────────────
# Your real SSOT — keep it outside this repo (or rely on .gitignore).
# SSOT_PATH=/path/to/ssot.json
# Where generated CV / cover letter / prep docs are written.
# OUTPUT_DIR=out
